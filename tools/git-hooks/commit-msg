#!/usr/bin/env bash
# Blocks any message that isn't a Conventional Commit with a known scope.
# Enable once per clone: git config core.hooksPath tools/git-hooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
if [[ ! -x node_modules/.bin/commitlint ]]; then
  echo "error: commitlint is not installed. Run: npm install" >&2
  exit 1
fi
exec node_modules/.bin/commitlint --edit "$1"
